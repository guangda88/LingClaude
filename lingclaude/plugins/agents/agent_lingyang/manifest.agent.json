{
  "name": "agent/lingyang",
  "target": "lingyang-carrier",
  "display_name": "灵扬",
  "version": "0.1.0",
  "trust_level": "T2",
  "plug_level": "L1",
  "caller": "lingclaude",
  "transport": {
    "kind": "cli",
    "mode": "registry",
    "command": [
      "python3",
      "src/mcp_server.py"
    ],
    "cwd": "/home/ai/lingyang",
    "call_timeout_s": 120
  },
  "stop_layer": {
    "kernel": "CLI 载体（pyproject 实锤 src.__main__:main）→ 联系人/成长报告/指标工具面",
    "seams": [
      "family_agent"
    ],
    "implementations": 1,
    "note": "子插片接缝=family_agent（agent_family 基类参数化实现）"
  },
  "capabilities": [
    "contacts",
    "growth_report",
    "metrics"
  ],
  "health_probe": {
    "interval_s": 300,
    "timeout_s": 5,
    "method": "carrier_check",
    "absent_after": 2
  },
  "state_record": "agent_run:lingyang",
  "org_member": "lingyang",
  "notes": "家族批量插片化批2（用户 2026-09-18 指令 20 实体全量插片化）。运行时未安装（无 venv 实测）：探针 absent 属预期，批2 清偿载体侧 editable 安装。债务总账：family-carriers-batch2-4（due 2026-10-15）。"
}