{
  "name": "git_plugin",
  "version": "1.0.0",
  "type": "tool",
  "entry": "lingclaude/plugins/tools/git/plugin.py:GitPlugin",
  "description": "git 工具组插件：status/diff/log/blame/push/preflight（委托 engine/git，不复制主干逻辑）",
  "requires": [],
  "provides": [
    "git_status",
    "git_diff",
    "git_log",
    "git_blame",
    "git_push",
    "git_push_preflight"
  ],
  "enabled": true,
  "test_entry": "lingclaude/plugins/tools/git/test_git_plugin.py",
  "stop_layer": {
    "kernel": "execute 分派薄壳（工具名→engine/git 委托）",
    "seams": [
      "engine/git"
    ],
    "implementations": 1
  }
}