#!/bin/sh
# 纯委托：core.hooksPath 生效后，非 pre-commit 钩子原样交给 .git/hooks/（灵字辈 post-commit v3.0 / lefthook post-commit）
ROOT="$(git rev-parse --show-toplevel)"
# 新克隆未跑 lefthook install 时 .git/hooks/post-commit 可能不存在——静默通过
[ -x "$ROOT/.git/hooks/post-commit" ] || exit 0
exec "$ROOT/.git/hooks/post-commit" "$@"
