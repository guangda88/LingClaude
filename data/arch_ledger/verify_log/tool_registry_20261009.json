 {
  "description": "Task list: full plan OR incremental patch (two shapes). PLAN: pass `todos` (list of {content, status}) + `active_id` = content of the ONE in_progress item (\"none\" if none). Items keep their id when content matches; missing items are removed. PATCH: {\"action\":\"add\",\"content\":\"...\"} inserts a new pending task in O(1) (capture new instructions immediately as todos); {\"action\":\"update\",\"id\":\"t3\",\"status\":\"completed|in_progress|pending\"} advances one item. Rules: update status in real time (never batch); if blocked, keep current item in_progress and add a follow-up todo describing the blocker; mark completed ONLY after verification.",
  "handler_direct": false,
  "handler_name": "todo_write",
  "handler_resolved": "_todo_write_handler",
  "is_concurrency_safe": false,
  "name": "todo_write",
  "parameters": {
   "action": {
    "description": "PATCH shape: \"add\" (insert new pending task) or \"update\" (change one item status). Mutually exclusive with `todos`.",
    "enum": [
     "add",
     "update"
    ],
    "type": "string"
   },
   "active_id": {
    "description": "Content of the ONE in_progress item (\"none\" if all pending/completed). Exactly one unless \"none\". PLAN shape only.",
    "type": "string"
   },
   "content": {
    "description": "PATCH add: task content (one verifiable action).",
    "type": "string"
   },
   "id": {
    "description": "PATCH update: todo id from the authoritative list returned by this tool (e.g. \"t3\").",
    "type": "string"
   },
   "status": {
    "description": "PATCH update: new status.",
    "enum": [
     "pending",
     "in_progress",
     "completed"
    ],
    "type": "string"
   },
   "todos": {
    "description": "PLAN shape: full task list (replaces previous; matching content keeps its id). Each item: {\"content\": \"one verifiable action\", \"status\": \"pending|in_progress|completed\"}.",
    "items": {
     "properties": {
      "content": {
       "description": "Concrete task, e.g. \"add retry to fetch_user\"",
       "type": "string"
      },
      "status": {
       "enum": [
        "pending",
        "in_progress",
        "completed"
       ],
       "type": "string"
      }
     },
     "required": [
      "content",
      "status"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "security_scope": "write"
 },
