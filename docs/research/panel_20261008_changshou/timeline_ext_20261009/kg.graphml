  <data key="d0">event</data>
  <data key="d1">1995年10月</data>
  <data key="d2">1995</data>
  <data key="d3">10</data>
  <data key="d4">0</data>
  <data key="d5">month</data>
  <data key="d6">1995年10月，“中心”老师来内江办班。〔源:3.杂志〕</data>
</node>
<node id="E0618">
  <data key="d0">event</data>
  <data key="d1">1995年11月10日</data>
  <data key="d2">1995</data>
  <data key="d3">11</data>
  <data key="d4">10</data>
  <data key="d5">day</data>
  <data key="d6">1995年11月10日 庞老师前往河北、河南、湖北、湖南等地讲学。</data>
</node>
<node id="E0619">
  <data key="d0">event</data>
  <data key="d1">1995年11月17日</data>
  <data key="d2">1995</data>
  <data key="d3">11</data>
  <data key="d4">17</data>
  <data key="d5">day</data>
  <data key="d6">1995年11月17日 《中国经济时报》再次以整版的篇幅刊登了第二次采访庞明同志的访谈录：《探寻中国气功之路》。文中阐述了对发展中国气功事业的深刻思考。</data>
</node>
<node id="E0620">
  <data key="d0">event</data>
  <data key="d1">1995年11月21日</data>
  <data key="d2">1995</data>
  <data key="d3">11</data>
  <data key="d4">21</data>
  <data key="d5">day</data>
  <data key="d6">1995年11月21日，我又陪同庞老师再次访问了南街村，又和王洪斌书记、徐兴山顾问进行了交谈。〔源:3.杂志〕</data>
</node>
<node id="E0621">
  <data key="d0">event</data>
  <data key="d1">1995年11月23日</data>
  <data key="d2">1995</data>
  <data key="d3">11</data>
  <data key="d4">23</data>
  <data key="d5">day</data>
  <data key="d6">1995年11月23日，我校成立山东省人体生命科学研究会山东农大分会时，省人体生命科学研究会会长杨海岩与校领导李培华副书记、刘洪森副校长分别作了重要讲话，给大家以极大鼓舞；〔源:3.杂志〕</data>
</node>
<node id="E0622">
  <data key="d0">event</data>
