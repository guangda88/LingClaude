  <data key="d4">10</data>
  <data key="d5">day</data>
  <data key="d6">1995年9月10日 庞老师离开秦皇岛，前往河北、广西、湖南、浙江、上海等省、市讲学。</data>
</node>
<node id="E0738">
  <data key="d0">event</data>
