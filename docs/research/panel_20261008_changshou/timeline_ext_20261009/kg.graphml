  <data key="d2">1993</data>
  <data key="d3">11</data>
  <data key="d4">21</data>
  <data key="d5">day</data>
  <data key="d6">1993年11月21日卜午，康复一部在王字楼二楼前厅举办学员科学实验成果展示。〔源:3.杂志〕</data>
</node>
<node id="E0321">
  <data key="d0">event</data>
