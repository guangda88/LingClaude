  <data key="d4">0</data>
  <data key="d5">month</data>
  <data key="d6">1997年12月，“中心”举办了“首届智能气功抗癌明星会”，有142名抗癌明星参加了大会。〔源:3.杂志〕</data>
</node>
<node id="E1019">
  <data key="d0">event</data>
