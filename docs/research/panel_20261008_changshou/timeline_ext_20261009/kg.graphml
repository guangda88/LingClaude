  <data key="d4">10</data>
  <data key="d5">day</data>
  <data key="d6">1993年11月10日 上午庞老师参加锦州分校开学典礼；下午赴辽河油田讲学。</data>
</node>
<node id="E0317">
  <data key="d0">event</data>
