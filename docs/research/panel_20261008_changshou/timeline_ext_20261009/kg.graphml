  <data key="d2">1993</data>
  <data key="d3">11</data>
  <data key="d4">6</data>
  <data key="d5">day</data>
  <data key="d6">1993年11月6日 庞老师与康复一部55 期学员握手交换信息。</data>
</node>
<node id="E0326">
  <data key="d0">event</data>
  <data key="d1">1993年11月</data>
  <data key="d2">1993</data>
  <data key="d3">11</data>
  <data key="d4">0</data>
  <data key="d5">month</data>
  <data key="d6">1993年11月，智能气功传入我县，举办了首期学习班，成立了智能气功赣县辅导站。〔源:3.杂志〕</data>
</node>
<node id="E0327">
  <data key="d0">event</data>
