  <data key="d0">event</data>
  <data key="d1">1992年</data>
  <data key="d2">1992</data>
  <data key="d3">0</data>
  <data key="d4">0</data>
  <data key="d5">year</data>
  <data key="d6">1992年底他参加第二届全国智能气功科学学术交流会回来，一边向领导、群众宣传会议精神，一边组织大家搞气功科研。〔源:3.杂志〕</data>
</node>
