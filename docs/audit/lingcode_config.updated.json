          },
          {
            "provider": "deepseek",
            "model": "deepseek-v4-flash"
          },
          {
            "provider": "hunyuan",
            "model": "hunyuan-lite"
          }
        ]
      },
      "safety": {
        "description": "内容安全检测、审核",
        "models": [
          {
            "provider": "deepseek",
            "model": "deepseek-v4-flash"
          },
          {
            "provider": "hunyuan",
            "model": "hunyuan-lite"
          }
        ]
      },
      "embedding": {
        "description": "向量化、语义检索",
        "models": [
          {
            "provider": "nvidia",
            "model": "nvidia/nv-embed-v1"
          },
          {
            "provider": "nvidia",
            "model": "baai/bge-m3"
          },
          {
            "provider": "deepseek",
