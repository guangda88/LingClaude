          }
        ]
      },
      "fast_response": {
        "description": "轻量快速响应，简单任务",
        "models": [
          {
            "provider": "waterfall",
            "model": "waterfall"
          },
          {
            "provider": "deepseek",
            "model": "deepseek-v4-flash"
          },
          {
            "provider": "qwen3.8",
