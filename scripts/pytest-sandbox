#!/bin/bash
# 沙箱 /dev/null 受限环境的 pytest 包装器（宿主侧 bwrap 真修复前使用）
# 用法: scripts/pytest-sandbox [pytest 参数...]
HERE="$(cd "$(dirname "$0")" && pwd)"
export PYTHONPATH="$HERE${PYTHONPATH:+:$PYTHONPATH}"
# pytest 参数路径守卫：凭记忆猜的测试文件名在此 fail-fast（防 no tests ran 假绿）
python3 "$HERE/guard_pytest_args.py" "$@" || exit $?
exec python3 -m pytest -p devnull_fallback_plugin "$@"
