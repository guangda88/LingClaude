{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "zen-bridge": {
      "mode": "primary",
      "model": "opencode/big-pickle",
      "description": "Text-only completion backend for scripts/oc_free_bridge.py (all tool execution denied)",
      "permission": {
        "read": "deny",
        "edit": "deny",
        "glob": "deny",
        "grep": "deny",
        "list": "deny",
        "bash": "deny",
        "task": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "lsp": "deny",
        "external_directory": "deny",
        "question": "deny",
        "todowrite": "allow",
        "read": {
          "*": "deny",
          "/tmp/oc-bridge-sandbox/**": "allow"
        }
      }
    }
  }
}
